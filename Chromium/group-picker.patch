 namespace chrome {
 
+class MyBroTabGroupTest : public InProcessBrowserTest {
+ public:
+  MyBroTabGroupTest() {
+    features_.InitAndEnableFeature(features::kTabGroupsFocusing);
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
+
+IN_PROC_BROWSER_TEST_F(MyBroTabGroupTest, NewTabStaysInSelectedGroup) {
+  TabStripModel* model = browser()->tab_strip_model();
+  chrome::NewTab(browser(), NewTabTypes::kNewTabCommand);
+  chrome::NewTab(browser(), NewTabTypes::kNewTabCommand);
+  const auto work = model->AddToNewGroup({1});
+  const auto personal = model->AddToNewGroup({2});
+
+  model->EnterFocusMode(work);
+  chrome::NewTab(browser(), NewTabTypes::kNewTabButton);
+  EXPECT_EQ(work, model->GetFocusedGroup());
+  EXPECT_EQ(work, model->GetTabGroupForTab(model->active_index()));
+
+  model->EnterFocusMode(personal);
+  chrome::NewTab(browser(), NewTabTypes::kNewTabCommand);
+  EXPECT_EQ(personal, model->GetFocusedGroup());
+  EXPECT_EQ(personal, model->GetTabGroupForTab(model->active_index()));
+
+  model->ExitFocusMode();
+  EXPECT_FALSE(model->GetFocusedGroup().has_value());
+  EXPECT_EQ(5, model->count());
+}
