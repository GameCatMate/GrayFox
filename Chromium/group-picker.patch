+// Place the group switcher outside the filtered tab strip.
+class MyBroGroupPicker : public views::View,
+                         public TabStripModelObserver,
+                         public ui::SimpleMenuModel::Delegate {
+ public:
+  explicit MyBroGroupPicker(BrowserWindowInterface* browser)
+      : browser_(browser) {
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 2))
+        ->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+    browser_->GetTabStripModel()->AddObserver(this);
+    Refresh();
+  }
+
+ private:
+  using GroupId = std::optional<tab_groups::TabGroupId>;
+
+  void OnTabStripModelChanged(TabStripModel* model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override {
+    if (auto* tab = model->GetActiveTab()) {
+      last_tab_[tab->GetGroup()] = tab->GetHandle();
+    }
+    ScheduleRefresh();
+  }
+
+  void OnTabGroupChanged(const TabGroupChange& change) override {
+    ScheduleRefresh();
+  }
+
+  void OnTabGroupFocusChanged(GroupId new_group, GroupId old_group) override {
+    ScheduleRefresh();
+  }
+
+  void OnTabStripModelDestroyed(TabStripModel* model) override {
+    weak_factory_.InvalidateWeakPtrs();
+  }
+
+  void ScheduleRefresh() {
+    if (refresh_pending_) {
+      return;
+    }
+    refresh_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&MyBroGroupPicker::Refresh,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Refresh() {
+    refresh_pending_ = false;
+    auto* model = browser_->GetTabStripModel();
+    GroupId selected = model->GetFocusedGroup();
+    if (!selected && model->GetActiveTab()) {
+      selected = model->GetActiveTab()->GetGroup();
+    }
+
+    std::vector<std::pair<GroupId, std::u16string>> groups;
+    int ungrouped_count = model->count();
+    for (const auto& id : model->group_model()->ListTabGroups()) {
+      const auto* group = model->group_model()->GetTabGroup(id);
+      if (group->is_ephemeral() || group->tab_count() == 0) {
+        continue;
+      }
+      ungrouped_count -= static_cast<int>(group->tab_count());
+      std::u16string title = group->visual_data()->title();
+      if (title.empty()) {
+        title = u"Группа без названия";
+      }
+      groups.emplace_back(id, base::NumberToString16(group->tab_count()) +
+                                  u" " + title);
+    }
+    groups.insert(groups.begin(),
+                  {std::nullopt, base::NumberToString16(ungrouped_count)});
+
+    // Keep the selected group visible even when it is past the inline limit.
+    constexpr size_t kInlineLimit = 4;
+    const bool has_overflow = groups.size() > kInlineLimit;
+    std::vector<std::pair<GroupId, std::u16string>> inline_groups = groups;
+    if (has_overflow) {
+      for (size_t i = kInlineLimit; i < groups.size(); ++i) {
+        if (groups[i].first == selected) {
+          inline_groups[kInlineLimit - 1] = groups[i];
+          break;
+        }
+      }
+      inline_groups.resize(kInlineLimit);
+    }
+    if (inline_groups != inline_groups_ || has_overflow != has_overflow_) {
+      menu_runner_.reset();
+      RemoveAllChildViews();
+      inline_groups_ = std::move(inline_groups);
+      has_overflow_ = has_overflow;
+      for (const auto& [id, label] : inline_groups_) {
+        auto* button = AddChildView(std::make_unique<views::LabelButton>(
+            base::BindRepeating(&MyBroGroupPicker::SelectGroup,
+                                base::Unretained(this), id), label));
+        button->SetMaxSize(gfx::Size(id ? 96 : 42, 28));
+        button->SetTooltipText(id ? label : u"Вкладки окна " + label);
+        button->SetAccessibleName(id ? label : u"Вкладки окна " + label);
+      }
+      if (has_overflow_) {
+        auto* overflow = AddChildView(std::make_unique<views::MenuButton>(
+            base::BindRepeating(&MyBroGroupPicker::OpenMenu,
+                                base::Unretained(this)), u"⌄"));
+        overflow->SetAccessibleName(u"Все группы");
+      }
+      PreferredSizeChanged();
+    }
+    for (size_t i = 0; i < inline_groups_.size(); ++i) {
+      auto* button = static_cast<views::LabelButton*>(children()[i].get());
+      const bool is_selected = inline_groups_[i].first == selected;
+      button->SetHighlighted(is_selected);
+      button->GetViewAccessibility().SetIsSelected(is_selected);
+    }
+    groups_ = std::move(groups);
+  }
+
+  void SelectGroup(GroupId group) {
+    auto* model = browser_->GetTabStripModel();
+    const auto last = last_tab_.find(group);
+    tabs::TabInterface* remembered =
+        last == last_tab_.end() ? nullptr : last->second.Get();
+    if (remembered && (model->GetIndexOfTab(remembered) == TabStripModel::kNoTab ||
+                       remembered->GetGroup() != group)) {
+      remembered = nullptr;
+    }
+    if (group) {
+      auto* groups = model->group_model();
+      if (!groups->ContainsTabGroup(*group) ||
+          groups->GetTabGroup(*group)->tab_count() == 0) {
+        return;
+      }
+      model->EnterFocusMode(*group);
+      if (remembered) {
+        model->ActivateTab(remembered);
+      }
+      return;
+    }
+    model->ExitFocusMode();
+    if (remembered) {
+      model->ActivateTab(remembered);
+      return;
+    }
+    for (int i = 0; i < model->count(); ++i) {
+      if (!model->GetTabGroupForTab(i)) {
+        model->ActivateTabAt(i);
+        return;
+      }
+    }
+    chrome::NewTab(browser_, NewTabTypes::kNewTabButton);
+    const int index = model->active_index();
+    if (index != TabStripModel::kNoTab && model->GetTabGroupForTab(index)) {
+      model->RemoveFromGroup({index});
+    }
+  }
+
+  void OpenMenu() {
+    if (menu_runner_ && menu_runner_->IsRunning()) {
+      return;
+    }
+    menu_runner_.reset();
+    menu_groups_ = groups_;
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    for (size_t i = 1; i < menu_groups_.size(); ++i) {
+      menu_model_->AddItem(static_cast<int>(i), menu_groups_[i].second);
+    }
+    auto* button = static_cast<views::MenuButton*>(children().back().get());
+    menu_runner_ = std::make_unique<views::MenuRunner>(menu_model_.get(), 0);
+    menu_runner_->RunMenuAt(GetWidget(), button->button_controller(),
+                            button->GetBoundsInScreen(),
+                            views::MenuAnchorPosition::kTopLeft,
+                            ui::mojom::MenuSourceType::kNone);
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    SelectGroup(menu_groups_[command_id].first);
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::map<GroupId, tabs::TabHandle> last_tab_;
+  std::vector<std::pair<GroupId, std::u16string>> groups_;
+  std::vector<std::pair<GroupId, std::u16string>> inline_groups_;
+  std::vector<std::pair<GroupId, std::u16string>> menu_groups_;
+  bool has_overflow_ = false;
+  bool refresh_pending_ = false;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+  base::WeakPtrFactory<MyBroGroupPicker> weak_factory_{this};
+};
 
